{
  "_comment": "Readable classes Bloom styles that Spotify 1.3.x no longer renders, mapped to the element that took their place. compat/build.py re-points every Bloom rule that uses one. Targets use hooks that have survived Spotify updates (ids, data-testid, data-encore-id, ARIA roles, structure) rather than Spotify's hashed class names, which change with every release. The lyric line classes have no such hook: .bloom-token-lyrics-* stand in for them and the extension fills them in at runtime from Spotify's own stylesheet. Check with compat/tools/coverage.js after each Spotify update.",
  "Root__main-view": "[id=\"main-view\"]",
  "Root__nav-bar": "[id=\"Desktop_LeftSidebar_Id\"]",
  "Root__right-sidebar": "div:has(> #main-view) > div:has(> .LayoutResizer__inline-start)",
  "Root__now-playing-bar": "div:has(> #main-view) > div:has(> [data-testid=\"now-playing-bar\"])",
  "now-playing-bar": "[data-testid=\"now-playing-bar\"] > div",
  "main-connectBar-connectBar": "[data-testid=\"now-playing-bar\"] > .encore-bright-accent-set",
  "player-controls": "[data-testid=\"player-controls\"]",
  "main-playPauseButton-button": "[data-testid=\"control-button-playpause\"]",
  "progress-bar__slider": "[data-testid=\"progress-bar-handle\"]",
  "volume-bar": "[data-testid=\"volume-bar\"]",
  "volume-bar__icon-button": "[data-testid=\"volume-bar-toggle-mute-button\"]",
  "cover-art": "[data-testid=\"cover-art-button\"]",
  "cover-art-image": "[data-testid=\"cover-art-button\"] img",
  "main-topBar-historyButtons": "#global-nav-bar div:has(> button[aria-label=\"Go back\"])",
  "main-globalNav-buddyFeed": "[data-restore-focus-key=\"buddy_feed\"]",
  "main-card-card": "[data-encore-id=\"card\"]",

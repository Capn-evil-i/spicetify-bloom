  "main-playButton-PlayButton": "[role=\"div\"]:has(> [data-encore-id=\"buttonPrimary\"])",
  "main-trackList-rowPlayPauseButton": "#main-view [role=\"grid\"][aria-colcount] [role=\"gridcell\"][aria-colindex=\"1\"] button",

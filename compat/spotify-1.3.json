  "main-entityHeader-imageContainer": "[data-testid=\"entity-header\"] button:has(img)",
  "main-entityHeader-imageContainerNew": "[data-testid=\"entity-header\"] button:has(img)",
  "playlist-playlist-actionBarBackground-background": "#main-view div:has(+ div [data-testid=\"action-bar\"])",
